# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN/custom domain for thumbnails & direct downloads (optional)
R2_PUBLIC_URL=

# Cron auth for /api/cron/retention
CRON_SECRET=

# Auth.js (NextAuth) — required for social login sessions
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Kakao / Google / Naver OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Payments — Toss Payments and/or PortOne (Iamport)
PAYMENT_PROVIDER=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=
PORTONE_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# GPU / AI inference (pick one via AI_PROVIDER or auto-detect)
AI_PROVIDER=
REPLICATE_API_TOKEN=
REPLICATE_FACE_MODEL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_URL=
COMFYUI_API_URL=
COMFYUI_WORKFLOW_PATH=

# Rate limits & signed download TTL
RATE_LIMIT_DOWNLOAD_IP=30
RATE_LIMIT_DOWNLOAD_USER=60
RATE_LIMIT_GENERATE_IP=20
RATE_LIMIT_GENERATE_USER=50
DOWNLOAD_URL_TTL_SEC=300

# Local JSON DB directory (users, ledger, orders)
DATA_DIR=

# Business disclosure (footer / KR ecommerce)
BUSINESS_COMPANY_NAME=
BUSINESS_CEO_NAME=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=support@studiocanvas.ai
BUSINESS_PHONE=
BUSINESS_HOSTING=Vercel / Cloudflare R2
