# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN/custom domain for thumbnails & direct downloads (optional)
R2_PUBLIC_URL=

# Cron auth for /api/cron/retention
CRON_SECRET=

# Admin-only routes (comma-separated Auth.js account emails)
ADMIN_EMAILS=admin@example.com
# Local-only escape hatch; keep false in production
ALLOW_CREDENTIALS_ADMIN=false
# Passwordless email sign-in is dev-only; keep unset/false in production
ALLOW_CREDENTIALS_SIGNUP=false

# HMAC secret for promotion code hashes and wallet cookies
PROMO_CODE_SECRET=

# Local JSON DB directory (default: ./.data). Ignored on Vercel — memory only
# (project FS is read-only; writing would throw EROFS).
# DATA_DIR=
# Force memory-only DB even locally:
# SCA_DB_MEMORY_ONLY=true


# Auth.js (NextAuth) — required for social login sessions
# REQUIRED in production: without AUTH_SECRET, /api/auth/supabase-bridge cannot mint sessions
# (OAuth bridge) and CSRF/session cookies will not validate across instances.
AUTH_SECRET=
# Canonical public origin (must match the browser host, including www)
NEXT_PUBLIC_SITE_URL=https://www.studio-canvas-ai.com
AUTH_URL=https://www.studio-canvas-ai.com
NEXTAUTH_URL=https://www.studio-canvas-ai.com
# Footer social icons (optional overrides)
# NEXT_PUBLIC_SOCIAL_TWITTER_URL=https://x.com/StudioCanvasAI
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/studiocanvasai
# NEXT_PUBLIC_SOCIAL_COMMUNITY_URL=https://discord.gg/your-invite
# Optional absolute API origin — leave unset so the browser uses same-origin /api/*
# NEXT_PUBLIC_API_URL=
# Local development overrides (uncomment for local only):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# ── Supabase Auth (Studio Canvas AI2 — Seoul) ───────────────────────────────
# Project URL: https://oorujqbivznftsyqilyj.supabase.co
# Google OAuth callback (Google Cloud → Authorized redirect URIs):
#   https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
# Site URL / Redirect URLs (Supabase Auth):
#   https://www.studio-canvas-ai.com
#   https://www.studio-canvas-ai.com/**
# Google Web Client ID (secret only in Supabase Google provider):
#   353413561216-du0ildtg6ehu9qj5hov9h7vpcl57ar10.apps.googleusercontent.com
# App uses Auth only — no custom Postgres tables required (see supabase/README.md).
NEXT_PUBLIC_SUPABASE_URL=https://oorujqbivznftsyqilyj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_AxCVc2TIp52WVL7OoprCbw_PAb4ktlm
# Alias (optional):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth.js fallbacks (unused for Google when Supabase Auth is configured)
GOOGLE_CLIENT_ID=353413561216-du0ildtg6ehu9qj5hov9h7vpcl57ar10.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Kakao — prefer Supabase Auth → Providers → Kakao (REST API key + Client Secret).
# Kakao Redirect URI must be:
#   https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
# App calls signInWithOAuth({ provider: 'kakao', redirectTo: site origin }).
# Auth.js fallback only (unused when Supabase Kakao is enabled):
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Naver OAuth (Auth.js fallback). For Supabase custom:naver, put Client ID/Secret
# in the Supabase dashboard and set Userinfo URL to:
#   https://www.studio-canvas-ai.com/api/auth/naver/userinfo
# (Scopes: profile only — not openid. See supabase/README.md.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: default is common (multi-tenant) Entra issuer
# MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Payments — Toss / PortOne (domestic) and Stripe (global)
PAYMENT_PROVIDER=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=
PORTONE_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Stripe (global checkout, subscriptions, customer portal)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# USD→KRW conversion (fallback when live FX fails). Default 1400.
USD_KRW_RATE=1400
# Optional public fallback for client bundles
# NEXT_PUBLIC_USD_KRW_RATE=1400
# Live FX endpoint (default: open.er-api.com USD latest)
# USD_KRW_FX_URL=https://open.er-api.com/v6/latest/USD

# GPU / AI inference (pick one via AI_PROVIDER or auto-detect)
AI_PROVIDER=
REPLICATE_API_TOKEN=
REPLICATE_FACE_MODEL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_URL=
COMFYUI_API_URL=
COMFYUI_WORKFLOW_PATH=

# Rate limits & signed download TTL
RATE_LIMIT_DOWNLOAD_IP=30
RATE_LIMIT_DOWNLOAD_USER=60
RATE_LIMIT_GENERATE_IP=20
RATE_LIMIT_GENERATE_USER=50
DOWNLOAD_URL_TTL_SEC=300

# Local JSON DB directory (users, ledger, orders)
DATA_DIR=

# Business disclosure (footer / KR ecommerce) — fill with real values in .env.local only
BUSINESS_COMPANY_NAME=Your Company Name
BUSINESS_CEO_NAME=Your Name
BUSINESS_REG_NO=000-00-00000
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=Your business address
BUSINESS_EMAIL=your-email@example.com
BUSINESS_PHONE=000-0000-0000
BUSINESS_HOSTING=Vercel / Cloudflare R2