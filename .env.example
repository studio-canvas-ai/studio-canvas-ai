# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional aliases (either naming works):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET_NAME=
# CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Public CDN / r2.dev / custom domain for browser-visible thumbnails (recommended)
R2_PUBLIC_URL=
# R2_ENDPOINT=
#
# Shorts video upload (phase 2): browser PUT via presigned URL → R2 key shorts/{userId}/{id}.ext
# Bucket CORS must allow PUT/HEAD/GET from https://www.studio-canvas-ai.com (and localhost).
# Example AllowedOrigins: https://www.studio-canvas-ai.com, http://localhost:3000
# AllowedMethods: GET, PUT, HEAD  |  AllowedHeaders: Content-Type, *
# SHORTS_MAX_VIDEO_BYTES=104857600
SHORTS_MAX_VIDEO_BYTES=

# Cron auth for /api/cron/retention
CRON_SECRET=

# Admin-only routes (comma-separated emails for dedicated /admin login).
# Also hardcoded in lib/unlimitedAccount.ts (PRIVILEGED_ADMIN_EMAILS) with 999-credit wallets.
ADMIN_EMAILS=scd77777@naver.com,studiocanvas.cs@gmail.com,hercd@hanmail.net,scd777@naver.com
# Shared password/token for the dedicated admin login form (HTTP-only cookie session)
ADMIN_PASSWORD=
# Alias for ADMIN_PASSWORD (either works)
# ADMIN_TOKEN=
# Legacy: allow Auth.js credentials provider users as admins (unused by dedicated admin login)
ALLOW_CREDENTIALS_ADMIN=false
# Passwordless email sign-in is dev-only; keep unset/false in production
ALLOW_CREDENTIALS_SIGNUP=false

# ── 1:1 Support Center (문의하기) ────────────────────────────────────────────
# Notify CS when a ticket is submitted via POST /api/support/tickets.
# Tickets persist to R2 key admin/support-tickets.json when R2 is configured.
# Prefer Resend (https://resend.com); SendGrid works as fallback.
# RESEND_API_KEY=re_xxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxx
SUPPORT_NOTIFY_TO=studiocanvas.cs@gmail.com
# Verified sender for Resend/SendGrid (use your domain in prod; Resend trial: onboarding@resend.dev)
# SUPPORT_EMAIL_FROM=Studio Canvas AI <onboarding@resend.dev>
# EMAIL_FROM=Studio Canvas AI <noreply@your-domain.com>

# HMAC secret for promotion code hashes and wallet cookies
PROMO_CODE_SECRET=

# Local JSON DB directory (default: ./.data). Ignored on Vercel — memory only
# (project FS is read-only; writing would throw EROFS).
# DATA_DIR=
# Force memory-only DB even locally:
# SCA_DB_MEMORY_ONLY=true


# Auth.js (NextAuth) — required for social login sessions
# REQUIRED in production: without AUTH_SECRET, /api/auth/supabase-bridge cannot mint sessions
# (OAuth bridge) and CSRF/session cookies will not validate across instances.
AUTH_SECRET=
# Canonical public origin (must match the browser host, including www)
NEXT_PUBLIC_SITE_URL=https://www.studio-canvas-ai.com
AUTH_URL=https://www.studio-canvas-ai.com
NEXTAUTH_URL=https://www.studio-canvas-ai.com
# Footer social icons (optional overrides)
# NEXT_PUBLIC_SOCIAL_TWITTER_URL=https://x.com/StudioCanvasAI
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/studiocanvasai
# NEXT_PUBLIC_SOCIAL_COMMUNITY_URL=https://discord.gg/your-invite
# Optional absolute API origin — leave unset so the browser uses same-origin /api/*
# NEXT_PUBLIC_API_URL=
# Local development overrides (uncomment for local only):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# ── Supabase Auth (PRIMARY social login — not NextAuth) ─────────────────────
# CANONICAL production project (all social OAuth + data). Do NOT use retired
# test project ysdccsfpxduqcqxgwuy (causes Kakao KOE006 redirect_uri mismatch).
#   Project ref: oorujqbivznftsyqilyj
#   Project URL: https://oorujqbivznftsyqilyj.supabase.co
#   IdP callback (Kakao/Google/Meta/Microsoft/Naver):
#     https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
#
# Required keys (.env.local + Vercel Production/Preview) — must match canonical:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   AUTH_SECRET
#   NEXT_PUBLIC_SITE_URL          (prod: https://www.studio-canvas-ai.com)
#   AUTH_URL / NEXTAUTH_URL       (same as SITE_URL; local: http://localhost:3000)
# Optional:
#   SUPABASE_SERVICE_ROLE_KEY     (admin)
#   GOOGLE_CLIENT_ID/SECRET       (unused while Supabase Google is enabled)
#
# Supabase Auth → URL Configuration Redirect URLs must include:
#   http://localhost:3000/**
#   https://www.studio-canvas-ai.com/**
#   https://studio-canvas-ai.vercel.app/**
NEXT_PUBLIC_SUPABASE_URL=https://oorujqbivznftsyqilyj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_AxCvc2Tip52WVL70oprCbw_PAb4ktlm
# Alias (optional):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required for /admin member list (profiles where terms_agreed=true).
# Supabase → Project Settings → API → service_role (secret). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=


# Auth.js Google fallback ONLY if Supabase env is missing (primary path ignores these).
# Also used for YouTube Data API upload OAuth (youtube.upload scope) via
# /api/shorts/youtube/connect — enable YouTube Data API v3 in Google Cloud.
GOOGLE_CLIENT_ID=962424226912-lc143aodb29ppf9s4f9e78fr777oqih.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI (Google Cloud Console → OAuth client):
#   https://www.studio-canvas-ai.com/api/shorts/youtube/callback
#   http://localhost:3000/api/shorts/youtube/callback
# Optional override (defaults to AUTH_URL + /api/shorts/youtube/callback):
# YOUTUBE_OAUTH_REDIRECT_URI=https://www.studio-canvas-ai.com/api/shorts/youtube/callback
# Kakao Talk Share — JavaScript key (NOT REST API key, NOT Supabase, NOT Client Secret).
# IMPORTANT: never use legacy key 1100b60f0a48158bf8afb868272112b4 (blocked in lib/kakaoShare.ts).
# Correct (32 hex chars): 11b99bf50fa43f53e8fab8e5272ff2b4
# Runtime Kakao.init NEVER reads this env — key is hardcoded in lib/kakaoShare.ts only.
# Optional debug logs: NEXT_PUBLIC_KAKAO_DEBUG=true or localStorage.sca_kakao_debug=1
NEXT_PUBLIC_KAKAO_JS_KEY=11b99bf50fa43f53e8fab8e5272ff2b4
# NEXT_PUBLIC_KAKAO_DEBUG=false
# Required for Error 4011 avoidance — register BOTH places:
#   1) App → Platform key → JavaScript key → JavaScript SDK 도메인
#   2) App → 제품 링크 관리 → 웹 도메인
# Domains: https://www.studio-canvas-ai.com  and  https://studio-canvas-ai.com
# Kakao Login — Supabase built-in: signInWithOAuth({ provider: 'kakao' }).
# Do NOT use provider: 'custom:kakao'.
# KOE205 (personal apps): queryParams.scope = profile_nickname,profile_image
#   (excludes account_email). Enable Allow users without an email in Supabase.
# Kakao Redirect URI:
#   https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
# App synthesizes {id}@users.kakao.id when email is missing.
# Auth.js fallback only:
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Naver OAuth (Auth.js fallback). For Supabase custom:naver, put Client ID/Secret
# in the Supabase dashboard and set Userinfo URL to:
#   https://www.studio-canvas-ai.com/api/auth/naver/userinfo
# (Scopes: profile only — not openid. See supabase/README.md.)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Microsoft — prefer Supabase Custom OAuth identifier `microsoft` (`custom:microsoft`).
# Azure Redirect URI must be:
#   https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
# App calls signInWithOAuth({ provider: 'custom:microsoft', redirectTo: site origin }).
# Auth.js fallback only (unused when Supabase custom:microsoft is enabled):
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: default is common (multi-tenant) Entra issuer
# MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
# Facebook / Instagram (Meta) — Supabase Auth → Providers → Facebook only.
# App ID: 1527934262363418 — Instagram UI buttons also use provider: 'facebook'.
# Valid OAuth Redirect URI:
#   https://oorujqbivznftsyqilyj.supabase.co/auth/v1/callback
# Do not configure a separate custom:instagram provider for site login.
# Auth.js fallbacks (unused when Supabase Facebook is enabled):
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Payments — Toss / PortOne (domestic) and Stripe (global)
PAYMENT_PROVIDER=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=store-20ba37af-2fd1-452b-8e02-32eb52d9f961
# KG Inicis V2 channel (PortOne). Override in production when ready.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-2a6f2d7d-26d7-41d1-a5e6-2ecf3359d5a3
# KCP 정기과금(빌링키) 전용 채널 — PortOne 콘솔 NHN KCP 빌링 채널 키 (channel-key-…).
# 월간 정기결제에 필수. 비우면 단건 CHANNEL_KEY로 대체하지 않고 주문 생성이 실패합니다.
NEXT_PUBLIC_PORTONE_BILLING_CHANNEL_KEY=
# Optional server-only alias if the public env cannot be inlined at build time:
# PORTONE_BILLING_CHANNEL_KEY=
PORTONE_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Stripe (global checkout, subscriptions, customer portal)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# USD→KRW conversion (fallback when live FX fails). Default 1400.
USD_KRW_RATE=1400
# Optional public fallback for client bundles
# NEXT_PUBLIC_USD_KRW_RATE=1400
# Live FX endpoint (default: open.er-api.com USD latest)
# USD_KRW_FX_URL=https://open.er-api.com/v6/latest/USD

# GPU / AI inference
# Auto-detect: FAL_KEY → REPLICATE_API_TOKEN → RUNPOD_API_KEY+ENDPOINT → COMFYUI_API_URL → mock A/B drafts
# Force with AI_PROVIDER=fal|replicate|runpod|comfyui|mock
# Soft mock fallback after provider errors (default on). Set ALLOW_INFERENCE_SOFT_MOCK=false to disable.
AI_PROVIDER=
ALLOW_INFERENCE_SOFT_MOCK=
# Fal.ai — FLUX.1 Kontext [pro] for Concept Gallery style pictorials
# Model ID: fal-ai/flux-pro/kontext  (https://fal.ai/models/fal-ai/flux-pro/kontext)
# https://fal.ai/models/fal-ai/flux-pro/kontext
FAL_KEY=
# Optional alias accepted by the client: FAL_API_KEY=
# AI background (/api/ai-background) uses fal-ai/flux/dev (override with FAL_BG_MODEL)
# FAL_BG_MODEL=fal-ai/flux/dev
# Conversational studio: POST /api/ai/command
# Gemini (GEMINI_API_KEY) = multilingual intent + English Flux prompt (CommandRouter)
GEMINI_API_KEY=
# Default model: gemini-3.5-flash (gemini-2.5-flash is retired / 404 on many keys)
# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_ROUTER_MODEL=gemini-3.5-flash
# Fal rembg: FAL_REMBG_MODEL=fal-ai/birefnet/v2
# Fal identity inpaint (optional): FAL_INPAINT_MODEL=fal-ai/flux-kontext-lora/inpaint
# Shared core: POST /api/ai/command mode=utility|agent
# Print-ready High-DPI + R2: POST /api/ai/print-export
# Each command is atomic (fresh requestId / englishPrompt); no cross-request prompt reuse.
# Optional model override (default fal-ai/flux-pro/kontext)
# FAL_FLUX_MODEL=fal-ai/flux-pro/kontext
# OpenAI Whisper STT for Shorts timed captions (/api/shorts/stt) — 1 credit per success
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
# Optional InstantID (or compatible) model, e.g. zsxkib/instant-id or owner/name:versionHash
REPLICATE_FACE_MODEL=zsxkib/instant-id
# RunPod RTX 4090 / serverless — set both to switch without code changes
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_URL=
COMFYUI_API_URL=
COMFYUI_WORKFLOW_PATH=

# Rate limits (upload/download default: 30 req per IP per 60s)
RATE_LIMIT_DOWNLOAD_IP=30
RATE_LIMIT_DOWNLOAD_USER=60
RATE_LIMIT_DOWNLOAD_WINDOW_MS=60000
RATE_LIMIT_GENERATE_IP=20
RATE_LIMIT_GENERATE_USER=50
RATE_LIMIT_UPLOAD_IP=30
RATE_LIMIT_UPLOAD_USER=60
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
DOWNLOAD_URL_TTL_SEC=300
# How often JWT reloads planId/credits from DB (default 15 min)
JWT_PLAN_CACHE_MS=900000
# HD original idle TTL is fixed at 24h in code (ORIGINAL_IDLE_TTL_MS)

# Local JSON DB directory (users, ledger, orders)
DATA_DIR=

# TEMP (KCP card review): guest checkout without login.
# After review, set both to false (or remove) and redeploy to restore member-only checkout.
# Or ask the agent: "결제 다시 원상복구하세요"
ALLOW_GUEST_CHECKOUT=true
NEXT_PUBLIC_ALLOW_GUEST_CHECKOUT=true

